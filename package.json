{
  "name": "accent-ui",
  "version": "1.0.0",
  "description": "Accént (`´ Accént`) Design System: Typographic Restraint, W3C Tokens, and Two-Tier Motion for Modern Web & Local AI Workflows",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.mjs",
      "require": "./dist/motion.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "accent-contribute": "./scripts/accent-contribute.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:lib": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "contribute": "node scripts/accent-contribute.js"
  },
  "keywords": [
    "design-system",
    "react",
    "nextjs",
    "framer-motion",
    "tokens",
    "w3c",
    "typography",
    "editorial-design"
  ],
  "author": "Kendall Kyle Cyree <rorshock@protonmail.com>",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4",
    "tsup": "^8.0.2",
    "typescript": "^5.5.3"
  }
}
